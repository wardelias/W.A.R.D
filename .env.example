# Copy to .env.local and fill in. Never commit real values.

# --- App ---------------------------------------------------------------------
# Public URL of the app (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Local values are printed by `pnpm db:start` (API URL, publishable and secret keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; used only for sync, tokens and cron.
SUPABASE_SECRET_KEY=

# Comma-separated list of emails allowed to sign in.
ALLOWED_EMAILS=you@example.com

# Shared secret for the scheduled /api/cron/tick call (32+ random characters).
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Google Calendar (step 10) ----------------------------------------------
# "google" for the real API, "fake" for an in-memory calendar (tests, local demo).
CALENDAR_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts Google tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Web Push (step 15) -----------------------------------------------------
# Generate a pair: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact URL
VAPID_SUBJECT=mailto:you@example.com
